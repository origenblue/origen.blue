/* ===========================
   ORIGEN plus — base.css
   Reset + tipografía + variables de marca
   =========================== */

:root {
  /* Paleta ORIGEN — Azul cielo suave */
  --origen-blue: #3B9FE0;
  --origen-blue-dark: #2C7CB8;
  --origen-blue-darker: #1F5C8A;
  --origen-blue-light: #EAF6FF;
  --origen-blue-pale: #D6ECFB;

  /* Acento natural (verde suave, complementa "productos naturales") */
  --origen-green: #3FAE7A;
  --origen-green-light: #E6F7EF;

  /* Neutros */
  --origen-text: #1E2B38;
  --origen-text-muted: #55697A;
  --origen-white: #FFFFFF;
  --origen-border: #C9E4F7;

  /* Tipografía */
  --font-main: 'Urbanist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

  /* Espaciado */
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-main);
  background: linear-gradient(180deg, var(--origen-blue-light) 0%, var(--origen-white) 40%);
  color: var(--origen-text);
  line-height: 1.5;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3 {
  font-weight: 700;
  color: var(--origen-blue-darker);
  line-height: 1.2;
}

p {
  color: var(--origen-text);
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}
